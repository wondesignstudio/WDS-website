# Public application configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-REPLACE_ME
NEXT_PUBLIC_PUBLISH_MARKETING_CATNIP=false

# Server-only Supabase access. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# Transactional email (Resend)
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM_EMAIL="WDS <contact@wondesign.studio>"
CONTACT_NOTIFICATION_TO=wondesign01@gmail.com
CONTACT_CONFIRMATION_REPLY_TO=wondesign01@gmail.com
# Set to "[PREVIEW] " in preview environments; leave blank in production.
EMAIL_SUBJECT_PREFIX=

# Generate independent random values of at least 32 bytes.
RATE_LIMIT_HMAC_SECRET=REPLACE_WITH_RANDOM_SECRET
CRON_SECRET=REPLACE_WITH_RANDOM_SECRET
