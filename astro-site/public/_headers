/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains

/
  Cache-Control: public, max-age=0, must-revalidate

/work*
  Cache-Control: no-store
  CDN-Cache-Control: no-store

/contact*
  Cache-Control: no-store
  CDN-Cache-Control: no-store

/about*
  Cache-Control: public, max-age=0, must-revalidate

/services*
  Cache-Control: public, max-age=0, must-revalidate

/privacy*
  Cache-Control: no-store
  CDN-Cache-Control: no-store

# Editorial HTML must reflect unpublishing, not a week-old shared-cache copy.
/insights
  Cache-Control: no-store
  CDN-Cache-Control: no-store

/insights/*
  Cache-Control: no-store
  CDN-Cache-Control: no-store

/search-index.json
  Cache-Control: no-store
  CDN-Cache-Control: no-store

/sitemap*.xml
  Cache-Control: no-store
  CDN-Cache-Control: no-store

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/uploads/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Keep the review project out of search results without changing the live domain.
https://wds-studio-preview.pages.dev/*
  X-Robots-Tag: noindex, nofollow

https://:deployment.wds-studio-preview.pages.dev/*
  X-Robots-Tag: noindex, nofollow
