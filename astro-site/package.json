{
  "name": "wds-astro-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test:content": "node scripts/validate-build.mjs",
    "test:contact": "node --test scripts/contact-form.test.mjs",
    "verify": "npm run check && npm run test:contact && npm run build && npm run test:content"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.1",
    "gsap": "3.15.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "sharp": "0.35.5",
    "typescript": "5.9.3"
  }
}
